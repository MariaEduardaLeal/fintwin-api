APP_NAME=FinTwin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0 (Sail)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fintwin
DB_USERNAME=sail
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=fintwin_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum
SANCTUM_TOKEN_PREFIX=fintwin_

# Open Finance - Pluggy (never commit real credentials)
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_TIMEOUT=15
PLUGGY_CONNECT_TIMEOUT=5
PLUGGY_API_KEY_TTL=6000

# AI Advisor - DeepSeek (never commit real API keys)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_CONNECT_TIMEOUT=5

# Market Data - Brapi (never commit real tokens)
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_API_TOKEN=
BRAPI_TIMEOUT=15
BRAPI_CONNECT_TIMEOUT=5
BRAPI_QUOTE_BATCH_SIZE=1

# Google OAuth (Mobile Sign-In - never commit secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_TOKENINFO_BASE_URL=https://oauth2.googleapis.com

# Laravel Horizon
HORIZON_PREFIX=fintwin_horizon:
HORIZON_ALLOWED_EMAILS=

# OpenTelemetry Observability
OTEL_ENABLED=true
OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_SERVICE_NAME=fintwin-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
JAEGER_UI_PORT=16686

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@fintwin.local"
MAIL_FROM_NAME="${APP_NAME}"
